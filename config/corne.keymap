#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <160>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_bkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 3>;
            timeout-ms = <50>;
        };

        right_bkt {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
            timeout-ms = <50>;
        };

        left_par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <15 16>;
            timeout-ms = <50>;
        };

        right_par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 20>;
            timeout-ms = <50>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <27 28>;
            timeout-ms = <50>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <32 31>;
            timeout-ms = <50>;
        };

        bac {
            bindings = <&kp BACKSLASH>;
            key-positions = <5 6>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <17 18>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E         &kp R         &kp T            &kp Y            &kp U         &kp I        &kp O    &kp P               &kp BSPC
&kp ESC    &kp A  &kp S  &kp D         &kp F         &kp G            &kp H            &kp J         &kp K        &kp L    &hm RGUI SEMICOLON  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C         &kp V         &kp B            &kp N            &kp M         &kp COMMA    &kp DOT  &kp FSLH            &hm RSHFT RETURN
                         &kp LEFT_ALT  &ltq 1 SPACE  &hm LCTRL SPACE  &hm RSHFT ENTER  &ltq 2 SPACE  &ltq 3 RALT
            >;
        };

        numbers {
            bindings = <
&kp GRAVE   &kp DEL        &trans         &trans     &trans     &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp N7        &kp N8   &kp N9  &kp N0            &kp BACKSLASH
&caps_word  &kp SLASH      &kp ASTERISK   &kp MINUS  &kp PLUS   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp N4        &kp N5   &kp N6  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans      &kp BACKSPACE  &kp BACKSPACE  &kp UNDER  &kp EQUAL  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp N1        &kp N2   &kp N3  &trans            &trans
                                          &mo 3      &trans     &mo 2                 &trans                 &kp NUMBER_0  &kp DOT
            >;
        };

        functions {
            bindings = <
&gresc  &kp F1  &kp F2   &kp F3   &kp F4   &trans  &kp PG_UP  &kp HOME  &kp UP           &kp END    &kp DEL          &trans
&gresc  &kp F5  &kp F6   &kp F7   &kp F8   &trans  &kp PG_DN  &kp LEFT  &kp DOWN         &kp RIGHT  &kp INS          &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans     &trans    &kp PRINTSCREEN  &trans     &kp PAUSE_BREAK  &trans
                         &trans   &mo 3    &trans  &mo 1      &trans    &trans
            >;
        };

        settings {
            bindings = <
&sys_reset         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_CLR       &trans  &trans  &trans  &trans  &trans  &sys_reset
&out OUT_TOG       &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &trans  &trans  &trans  &trans  &trans  &out OUT_TOG
&ext_power EP_TOG  &rgb_ug RGB_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &trans  &trans  &trans  &trans  &trans  &ext_power EP_TOG
                                                     &trans           &trans           &to 0            &to 0   &trans  &trans
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };

        extra4 { status = "reserved"; };
    };
};
