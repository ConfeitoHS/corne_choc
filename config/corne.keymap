#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 5 seconds or longer.
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
        };

        ltb: ltb {
            compatible = "zmk,behavior-hold-tap";
            label = "LTB";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "balanced";
            quick-tap-ms = <200>;
        };

        mth: mth {
            compatible = "zmk,behavior-hold-tap";
            label = "MTH";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "hold-preferred";
            hold-while-undecided;
        };

        lthl: lthl {
            compatible = "zmk,behavior-hold-tap";
            label = "LTHL";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <1500>;
            flavor = "hold-preferred";
            quick-tap-ms = <200>;
        };

        lth: lth {
            compatible = "zmk,behavior-hold-tap";
            label = "LTH";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "hold-preferred";
            quick-tap-ms = <200>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R         &kp T             &kp Y             &kp U         &kp I      &kp O    &kp P          &kp BSPC
&kp ESC    &kp A  &kp S  &kp D     &kp F         &kp G             &kp H             &kp J         &kp K      &kp L    &kp SEMICOLON  &mt LEFT_GUI SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V         &kp B             &kp N             &kp M         &kp COMMA  &kp DOT  &kp FSLH       &mth RSHFT RETURN
                         &kp LALT  &lth 1 SPACE  &mth LCTRL SPACE  &mth RSHFT SPACE  &lth 2 SPACE  &kp RALT
            >;
        };

        nums {
            display-name = "NUMS";
            bindings = <
&kp GRAVE   &kp DEL        &trans         &trans     &trans     &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp N7        &kp N8   &kp N9  &kp N0            &kp BACKSLASH
&caps_word  &kp SLASH      &kp ASTERISK   &kp MINUS  &kp PLUS   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp N4        &kp N5   &kp N6  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans      &kp BACKSPACE  &kp BACKSPACE  &kp UNDER  &kp EQUAL  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp N1        &kp N2   &kp N3  &trans            &trans
                                          &mo 3      &trans     &mo 2                 &trans                 &kp NUMBER_0  &kp DOT
            >;
        };

        func {
            display-name = "FUNC";
            bindings = <
&gresc  &kp F1  &kp F2   &kp F3   &kp F4   &trans  &kp PG_UP  &kp HOME  &kp UP           &kp END    &kp DEL          &trans
&gresc  &kp F5  &kp F6   &kp F7   &kp F8   &trans  &kp PG_DN  &kp LEFT  &kp DOWN         &kp RIGHT  &kp INS          &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans     &trans    &kp PRINTSCREEN  &trans     &kp PAUSE_BREAK  &trans
                         &trans   &mo 3    &trans  &mo 1      &trans    &mo 3
            >;
        };

        conf {
            display-name = "CONF";
            bindings = <
&sys_reset      &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_CLR       &soft_off  &trans  &trans  &trans  &trans  &sys_reset
&out OUT_TOG    &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &trans     &trans  &trans  &trans  &trans  &out OUT_TOG
&trans      &rgb_ug RGB_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &trans     &trans  &trans  &trans  &trans  &trans
                                                  &trans           &trans           &to 0            &to 0      &trans  &trans
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };

        extra4 { status = "reserved"; };
    };
};
